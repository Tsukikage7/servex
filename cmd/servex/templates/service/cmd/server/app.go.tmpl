// newConfig 加载配置.
func newConfig() (*Config, error) {
	return config.LoadWithSearch[Config]("config.dev", []string{"configs", "."})
}

// newLogger 创建日志.
func newLogger(cfg *Config) (logger.Logger, func(), error) {
	cfg.Observability.Service.Name = cfg.Name
	cfg.Observability.Service.Version = cfg.Version
	cfg.Observability.ApplyDefaults()
	log, err := logger.NewLogger(&cfg.Observability.Logger)
	if err != nil {
		return nil, nil, err
	}
	return log, func() { _ = log.Close() }, nil
}

{{range .AllComponents}}
{{.NewCode}}
{{end}}

// newApp 创建应用.
func newApp(cfg *Config, log logger.Logger) (*app.Application, error) {
	application := app.New(
		app.WithLogger(log),
		app.WithName(cfg.Name),
		app.WithVersion(cfg.Version),
	)

	var servers []transport.Server
{{- if .WithGateway}}
	gatewaySrv, err := port.NewGateway(cfg.Gateway, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, gatewaySrv)
{{- else}}
	httpSrv, err := port.NewHTTP(cfg.HTTP, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, httpSrv)
{{- if .WithGRPC}}
	servers = append(servers, port.NewGRPC(cfg.GRPC, log))
{{- end}}
{{- end}}

	application.Use(servers...)
	return application, nil
}
