package main

import (
{{- range $imp := extraImports .AllComponents}}
	"{{$imp}}"
{{- end}}
{{- range .AllComponents}}{{if .Alias}}
	{{.Alias}} "{{.Import}}"
{{- else}}
	"{{.Import}}"
{{- end}}{{end}}
{{- range .AllComponents}}{{range .BlankImports}}
	_ "{{.}}"
{{- end}}{{end}}

	"{{.Module}}/services/{{.Name}}/internal/port"
	"github.com/Tsukikage7/servex/v2/app"
	"github.com/Tsukikage7/servex/v2/config"
	"github.com/Tsukikage7/servex/v2/observability/logger"
	"github.com/Tsukikage7/servex/v2/transport"
)

// provideConfig 加载配置.
func provideConfig() (*Config, error) {
	return config.LoadWithSearch[Config]("config.dev", []string{"configs", "."})
}

// provideLogger 创建日志.
func provideLogger(cfg *Config) (logger.Logger, func()) {
	log := logger.MustNewLogger(&cfg.Logger)
	return log, func() { log.Sync() }
}

{{range .AllComponents}}
{{.ProviderCode}}
{{end}}

// provideApp 创建应用.
func provideApp(cfg *Config, log logger.Logger) (*app.Application, error) {
	application := app.New(
		app.WithLogger(log),
		app.WithName(cfg.Name),
		app.WithVersion(cfg.Version),
	)

	var servers []transport.Server
{{- if .WithGateway}}
	gatewaySrv, err := port.NewGateway(cfg.Gateway, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, gatewaySrv)
{{- else}}
	httpSrv, err := port.NewHTTP(cfg.HTTP, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, httpSrv)
{{- if .WithGRPC}}
	servers = append(servers, port.NewGRPC(cfg.GRPC, log))
{{- end}}
{{- end}}

	application.Use(servers...)
	return application, nil
}
