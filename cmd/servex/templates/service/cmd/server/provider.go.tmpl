// provideConfig 加载配置.
func provideConfig() (*Config, error) {
	return config.LoadWithSearch[Config]("config.dev", []string{"configs", "."})
}

// provideObservability 创建可观测性运行时.
func provideObservability(cfg *Config) (*observability.Runtime, func(), error) {
	cfg.Observability.Service.Name = cfg.Name
	cfg.Observability.Service.Version = cfg.Version
	rt, err := observability.NewRuntime(context.Background(), cfg.Observability)
	if err != nil {
		return nil, nil, err
	}
	return rt, func() { _ = rt.Shutdown(context.Background()) }, nil
}

// provideLogger 从可观测性运行时取得日志.
func provideLogger(rt *observability.Runtime) logger.Logger {
	return rt.Logger()
}

{{range .AllComponents}}
{{.ProviderCode}}
{{end}}

// provideApp 创建应用.
func provideApp(cfg *Config, log logger.Logger) (*app.Application, error) {
	application := app.New(
		app.WithLogger(log),
		app.WithName(cfg.Name),
		app.WithVersion(cfg.Version),
	)

	var servers []transport.Server
{{- if .WithGateway}}
	gatewaySrv, err := port.NewGateway(cfg.Gateway, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, gatewaySrv)
{{- else}}
	httpSrv, err := port.NewHTTP(cfg.HTTP, log)
	if err != nil {
		return nil, err
	}
	servers = append(servers, httpSrv)
{{- if .WithGRPC}}
	servers = append(servers, port.NewGRPC(cfg.GRPC, log))
{{- end}}
{{- end}}

	application.Use(servers...)
	return application, nil
}
