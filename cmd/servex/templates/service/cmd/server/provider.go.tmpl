// provideApp 创建应用.
func provideApp(cfg *Config, log logger.Logger, httpSrv transport.Server) *app.Application {
	application := app.New(
		app.WithLogger(log),
		app.WithName(cfg.Name),
	)
	application.Use(httpSrv)
	return application
}

