package port

import (
	"{{.Module}}/services/{{.Name}}-service/internal/service"

	"github.com/Tsukikage7/servex/v2/middleware/logging"
	"github.com/Tsukikage7/servex/v2/middleware/recovery"
	"github.com/Tsukikage7/servex/v2/observability/logger"
	"github.com/Tsukikage7/servex/v2/transport"
	"github.com/Tsukikage7/servex/v2/transport/grpcserver"
)

// NewGRPC 创建 gRPC 服务器.
func NewGRPC(log logger.Logger) transport.Server {
	srv := grpcserver.New(
		grpcserver.WithLogger(log),
		grpcserver.WithAddr(":9090"),
		grpcserver.WithReflection(true),
		grpcserver.WithUnaryInterceptor(
			recovery.UnaryServerInterceptor(recovery.WithLogger(log)),
			logging.UnaryServerInterceptor(logging.WithLogger(log)),
		),
		grpcserver.WithStreamInterceptor(
			recovery.StreamServerInterceptor(recovery.WithLogger(log)),
			logging.StreamServerInterceptor(logging.WithLogger(log)),
		),
	)

	// 注册 gRPC 服务（实现 grpcserver.Registrar 接口）
	srv.Register(service.New{{.Name | toPascalCase}}Service())

	return srv
}
