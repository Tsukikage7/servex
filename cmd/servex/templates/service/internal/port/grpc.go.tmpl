package port

import (
	"{{.Module}}/services/{{.Name}}-service/internal/service"

	"github.com/Tsukikage7/servex/observability/logger"
	"github.com/Tsukikage7/servex/transport"
	"github.com/Tsukikage7/servex/transport/grpcserver"
)

// NewGRPC 创建 gRPC 服务器.
func NewGRPC(log logger.Logger) transport.Server {
	srv := grpcserver.New(
		grpcserver.WithLogger(log),
		grpcserver.WithAddr(":9090"),
		grpcserver.WithReflection(true),
		grpcserver.WithRecovery(),
		grpcserver.WithLogging(),
	)

	// 注册 gRPC 服务（实现 grpcserver.Registrar 接口）
	srv.Register(service.New{{.Name | toPascalCase}}Service())

	return srv
}
