package port

import (
	"net/http"

	"github.com/Tsukikage7/servex/observability/logger"
	"github.com/Tsukikage7/servex/transport"
	"github.com/Tsukikage7/servex/transport/httpserver"
)

// NewHTTP 创建 HTTP 服务器.
func NewHTTP(log logger.Logger) transport.Server {
	router := httpserver.NewRouter()

	// 健康检查
	router.GET("/healthz", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		w.Write([]byte("ok"))
	}))

	// TODO: 注册业务路由
	// api := router.Group("/api/v1")
	// api.POST("/{{.Name}}", httpserver.Handle(create{{.Name | toPascalCase}}))
	// api.GET("/{{.Name}}/{id}", httpserver.HandleWith(decode{{.Name | toPascalCase}}ID, get{{.Name | toPascalCase}}))
	// api.PUT("/{{.Name}}/{id}", httpserver.HandleWith(decode{{.Name | toPascalCase}}ID, update{{.Name | toPascalCase}}))
	// api.DELETE("/{{.Name}}/{id}", httpserver.HandleWith(decode{{.Name | toPascalCase}}ID, delete{{.Name | toPascalCase}}))

	return httpserver.New(router,
		httpserver.WithLogger(log),
		httpserver.WithAddr(":8080"),
		httpserver.WithRecovery(),
		httpserver.WithLogging(),
	)
}
