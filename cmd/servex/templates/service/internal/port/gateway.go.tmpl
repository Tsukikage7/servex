package port

import (
	"context"

	"{{.Module}}/services/{{.Name}}/internal/service"

	"github.com/grpc-ecosystem/grpc-gateway/v2/runtime"
	"github.com/Tsukikage7/servex/v2/observability/logger"
	"github.com/Tsukikage7/servex/v2/transport"
	"github.com/Tsukikage7/servex/v2/transport/gateway"
	"google.golang.org/grpc"
)

// NewGateway 创建 API 网关HTTP + gRPC 双协议.
func NewGateway(cfg transport.GatewayConfig, log logger.Logger) (transport.Server, error) {
	srv, err := gateway.NewFromConfig(&cfg, log)
	if err != nil {
		return nil, err
	}

	// 注册服务同时注册 gRPC + REST 路由。
	srv.Register(newGatewayRegistrar(service.New{{.Name | toPascalCase}}Service()))

	return srv, nil
}

type gatewayRegistrar struct {
	service *service.{{.Name | toPascalCase}}Service
}

func newGatewayRegistrar(svc *service.{{.Name | toPascalCase}}Service) *gatewayRegistrar {
	return &gatewayRegistrar{service: svc}
}

func (r *gatewayRegistrar) RegisterGRPC(server grpc.ServiceRegistrar) {
	_ = server
}

func (r *gatewayRegistrar) RegisterGateway(_ context.Context, _ *runtime.ServeMux, _ *grpc.ClientConn) error {
	return nil
}
