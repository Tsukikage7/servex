package main

import (
	"os"

	"{{.Module}}/internal/server"
{{if .WithDB}}
	"github.com/Tsukikage7/servex/storage/rdbms"
{{end}}{{if .WithRedis}}
	srvredis "github.com/Tsukikage7/servex/storage/redis"
{{end}}
	"github.com/Tsukikage7/servex/app"
	"github.com/Tsukikage7/servex/observability/logger"
)

func main() {
	// 初始化日志
	log := logger.MustNewLogger(&logger.Config{
		Level:  "info",
		Format: "console",
		Output: "console",
	})
	defer log.Sync()
{{if .WithDB}}
	// 初始化数据库
	db, err := rdbms.NewDatabase(&rdbms.Config{
		Driver: rdbms.DriverMySQL,
		DSN:    envOr("DB_DSN", "root:password@tcp(127.0.0.1:3306)/{{.Name}}?charset=utf8mb4&parseTime=True&loc=Local"),
	}, log)
	if err != nil {
		log.Fatalf("init database: %v", err)
	}
	_ = db
{{end}}{{if .WithRedis}}
	// 初始化 Redis
	rdb, err := srvredis.NewClient(&srvredis.Config{
		Addr: envOr("REDIS_ADDR", "127.0.0.1:6379"),
	}, log)
	if err != nil {
		log.Fatalf("init redis: %v", err)
	}
	defer rdb.Close()
{{end}}
	// 创建 HTTP 服务器
	httpSrv := server.NewHTTP(log)

	// 创建应用
	application := app.New(
		app.WithLogger(log),
		app.WithName("{{.Name}}"),
	)
	application.Use(httpSrv)
{{if .WithGRPC}}
	// 创建 gRPC 服务器
	grpcSrv := server.NewGRPC(log)
	application.Use(grpcSrv)
{{end}}
	if err := application.Run(); err != nil {
		log.Fatalf("application error: %v", err)
	}
}

func envOr(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
