# 应用服务
# 依赖：需先启动 infra/docker-compose.yaml
version: "3.9"

networks:
  default:
    name: {{.Name}}-network
    external: true

services:
  {{.Name}}:
    build:
      context: ../..
      dockerfile: Dockerfile
    container_name: {{.Name}}-app
    environment:
      - CONFIG_PATH=/app/config.yaml
    ports:
      - "8080:8080"
    restart: unless-stopped
