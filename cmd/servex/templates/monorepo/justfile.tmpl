# {{.Name}} — Servex monorepo operations

default:
    @just --list

# ── 日常开发[Dev]──────────────────────────────────────────────────────

dev service="all":
    @if [ "{{"{{service}}"}}" = "all" ]; then \
      for dir in services/*; do [ -d "$$dir/cmd/server" ] && APP_ENV=dev go run "./$$dir/cmd/server" & done; wait; \
    else \
      APP_ENV=dev go run ./services/{{"{{service}}"}}/cmd/server; \
    fi

run service:
    APP_ENV=dev go run ./services/{{"{{service}}"}}/cmd/server

# ── 构建与生成[Build & Codegen]────────────────────────────────────────

build target="all":
    @if [ "{{"{{target}}"}}" = "all" ]; then \
      mkdir -p bin; \
      for dir in services/*/cmd/server; do svc=$$(basename "$$(dirname "$$(dirname "$$dir")")"); echo "building $$svc"; CGO_ENABLED=0 go build -ldflags "-s -w" -o "bin/$$svc" "./$$dir"; done; \
    else \
      mkdir -p bin; CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/{{"{{target}}"}} ./services/{{"{{target}}"}}/cmd/server; \
    fi

wire service="all":
    @if [ "{{"{{service}}"}}" = "all" ]; then \
      for dir in services/*/cmd/server; do (cd "$$dir" && go run -mod=mod github.com/google/wire/cmd/wire); done; \
    else \
      cd services/{{"{{service}}"}}/cmd/server && go run -mod=mod github.com/google/wire/cmd/wire; \
    fi

codegen target="all":
    @case "{{"{{target}}"}}" in \
      all|proto) cd api && buf generate ;; \
      *) echo "unsupported codegen target: {{"{{target}}"}}"; exit 1 ;; \
    esac

# ── 部署与基础设施[Deploy & Infra]────────────────────────────────────

infra action="up":
    @case "{{"{{action}}"}}" in \
      up) docker compose -f deploy/docker/infra/docker-compose.yaml up -d ;; \
      down) docker compose -f deploy/docker/infra/docker-compose.yaml down ;; \
      logs) docker compose -f deploy/docker/infra/docker-compose.yaml logs -f ;; \
      *) echo "unsupported infra action: {{"{{action}}"}}"; exit 1 ;; \
    esac

deploy service:
    @echo "deploy {{"{{service}}"}}: implement scripts/deploy/{{"{{service}}"}}.sh or wire your CI/CD here"

ops action service lines="100":
    @case "{{"{{action}}"}}" in \
      logs) tail -n "{{"{{lines}}"}}" -f logs/{{"{{service}}"}}/*.log ;; \
      health) curl -sf http://localhost:8080/healthz ;; \
      *) echo "unsupported ops action: {{"{{action}}"}}"; exit 1 ;; \
    esac

# ── 质量[Quality]──────────────────────────────────────────────────────

fmt:
    gofmt -w -s .

check target="all":
    @case "{{"{{target}}"}}" in \
      all) go mod tidy && go test ./... ;; \
      tidy) go mod tidy ;; \
      test) go test ./... ;; \
      vet) go vet ./... ;; \
      *) echo "unsupported check target: {{"{{target}}"}}"; exit 1 ;; \
    esac

test service="all":
    @if [ "{{"{{service}}"}}" = "all" ]; then \
      go test ./...; \
    else \
      go test ./services/{{"{{service}}"}}/...; \
    fi

clean:
    rm -rf bin tmp
