package {{.NameLower}}

import (
{{- if .NeedsTime}}
	"time"
{{- end}}

	"github.com/Tsukikage7/servex/v2/domain"
)

// {{.Name}} 聚合根.
type {{.Name}} struct {
	domain.AggregateRoot[{{.IDType}}]
{{- range .NonIDFields}}
	{{.CamelName}} {{.Type}}
{{- end}}
}

// New{{.Name}} 创建{{.Name}}聚合.
func New{{.Name}}(id {{.IDType}}{{range .NonIDFields}}, {{.CamelName}} {{.Type}}{{end}}) *{{.Name}} {
	o := &{{.Name}}{
		AggregateRoot: domain.NewAggregateRoot[{{.IDType}}](id),
{{- range .NonIDFields}}
		{{.CamelName}}: {{.CamelName}},
{{- end}}
	}
	o.RaiseEvent(&{{.Name}}CreatedEvent{
		BaseEvent: domain.NewBaseEvent("{{.Name}}Created"),
		ID:        id,
{{- range .NonIDFields}}
		{{.Name}}: {{.CamelName}},
{{- end}}
	})
	return o
}

// Reconstruct{{.Name}} 从持久化数据恢复聚合根不触发事件.
func Reconstruct{{.Name}}(id {{.IDType}}{{range .NonIDFields}}, {{.CamelName}} {{.Type}}{{end}}) *{{.Name}} {
	return &{{.Name}}{
		AggregateRoot: domain.NewAggregateRoot[{{.IDType}}](id),
{{- range .NonIDFields}}
		{{.CamelName}}: {{.CamelName}},
{{- end}}
	}
}

// --- Getters ---
{{range .NonIDFields}}
// {{.Name}} 返回{{.CamelName}}.
func (o *{{$.Name}}) {{.Name}}() {{.Type}} { return o.{{.CamelName}} }
{{end}}
{{- if .HasCommands}}
// --- 业务方法 ---
{{range .Commands}}
// {{.Name}} 执行{{.Name}}操作.
func (o *{{$.Name}}) {{.Name}}() {
	// TODO: implement business logic
	o.RaiseEvent(&{{$.Name}}{{.EventName}}Event{
		BaseEvent: domain.NewBaseEvent("{{$.Name}}{{.EventName}}"),
		ID:        o.ID(),
	})
}
{{end}}
{{- end}}
