// HandleList 处理列表查询.
func (s *Service) HandleList(ctx context.Context, query domain{{.Name}}.List{{.Name}}Query) ([]*domain{{.Name}}.{{.Name}}View, int64, error) {
	offset := (query.Page - 1) * query.PageSize
	aggs, total, err := s.repo.List(ctx, domain{{.Name}}.{{.Name}}Filter{}, offset, query.PageSize)
	if err != nil {
		return nil, 0, ErrListFailed.WithCause(err)
	}

	views := make([]*domain{{.Name}}.{{.Name}}View, len(aggs))
	for i, agg := range aggs {
		views[i] = &domain{{.Name}}.{{.Name}}View{
			ID: agg.ID(),
{{- range .NonIDFields}}
			{{.Name}}: agg.{{.Name}}(),
{{- end}}
		}
	}
	return views, total, nil
}
