func (s *Service) HandleGet(ctx context.Context, query domain{{.Name}}.Get{{.Name}}Query) (*domain{{.Name}}.{{.Name}}View, error) {
	agg, err := s.repo.FindByID(ctx, query.ID)
	if err != nil {
