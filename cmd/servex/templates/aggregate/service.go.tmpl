// Sentinel errors for service operations.
var (
	ErrSaveFailed     = errors.New(50001, "{{.NameLower}}.save_failed", "{{.NameLower}} 保存失败")
	ErrFindFailed     = errors.New(50002, "{{.NameLower}}.find_failed", "{{.NameLower}} 查询失败")
	ErrListFailed     = errors.New(50003, "{{.NameLower}}.list_failed", "{{.NameLower}} 列表查询失败")
	ErrDeleteFailed   = errors.New(50004, "{{.NameLower}}.delete_failed", "{{.NameLower}} 删除失败")
	ErrDispatchEvents = errors.New(50005, "{{.NameLower}}.dispatch_events_failed", "{{.NameLower}} 事件分发失败")
)

// Service {{.Name}}应用服务.
type Service struct {
	repo     domain{{.Name}}.Repository
	eventBus *domain.EventBus
}

// NewService 创建{{.Name}}应用服务.
func NewService(repo domain{{.Name}}.Repository, eventBus *domain.EventBus) *Service {
	return &Service{repo: repo, eventBus: eventBus}
}

// HandleCreate 处理创建命令.
func (s *Service) HandleCreate(ctx context.Context, cmd domain{{.Name}}.Create{{.Name}}Command) (*domain{{.Name}}.{{.Name}}View, error) {
	agg := domain{{.Name}}.New{{.Name}}(0{{range .NonIDFields}}, cmd.{{.Name}}{{end}})
	if err := s.repo.Save(ctx, agg); err != nil {
		return nil, ErrSaveFailed.WithCause(err)
	}
	if err := s.eventBus.Dispatch(ctx, agg.DomainEvents(), agg.ClearDomainEvents); err != nil {
		return nil, ErrDispatchEvents.WithCause(err)
	}
	return &domain{{.Name}}.{{.Name}}View{
		ID: agg.ID(),
{{- range .NonIDFields}}
		{{.Name}}: agg.{{.Name}}(),
{{- end}}
	}, nil
}
