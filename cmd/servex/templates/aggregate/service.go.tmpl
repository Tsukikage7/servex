func (s *Service) Handle{{.Name}}(ctx context.Context, cmd domain{{$.Name}}.{{.Name}}{{$.Name}}Command) error {
	agg, err := s.repo.FindByID(ctx, cmd.ID)
	if err != nil {
		return ErrFindFailed.WithCause(err)
	}
	agg.{{.Name}}()
	if err := s.repo.Save(ctx, agg); err != nil {
		return ErrSaveFailed.WithCause(err)
	}
	return s.eventBus.Dispatch(ctx, agg.DomainEvents(), agg.ClearDomainEvents)
}
