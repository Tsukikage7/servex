func (s *Service) HandleDelete(ctx context.Context, cmd domain{{.Name}}.Delete{{.Name}}Command) error {
	if err := s.repo.Delete(ctx, cmd.ID); err != nil {
		return ErrDeleteFailed.WithCause(err)
	}
