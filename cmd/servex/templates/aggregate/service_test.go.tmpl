package {{.NameLower}}

import (
	"context"
	"testing"
{{- if .NeedsTime}}
	"time"
{{- end}}

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"github.com/Tsukikage7/servex/v2/domain"

	domain{{.Name}} "{{.Module}}/domain/{{.NameLower}}"
